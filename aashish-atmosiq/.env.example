# Copy to .env and fill in. Never commit .env.
PORT=8080
# Required in production: long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Set to false ONLY if serving over plain HTTP (e.g. EC2 without a load balancer/TLS)
COOKIE_SECURE=true
DB_PATH=./data/atmosiq.db
# Optional: comma-separated emails that get the admin role when they sign up
ADMIN_EMAILS=

# NASA FIRMS map key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Gemini API key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=
# Google restricts gemini-2.5-* to existing users; new keys should use a 3.x model (see ai.google.dev/gemini-api/docs/deprecations)
GEMINI_MODEL=gemini-3.8-flash
# Reserved for the live Global Forest Watch integration (not used yet)
GFW_API_KEY=
