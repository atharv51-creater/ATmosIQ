# Copy to .env and fill in. Never commit .env.
PORT=8080
# Required in production: long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Set to false ONLY if serving over plain HTTP (e.g. EC2 without a load balancer/TLS)
COOKIE_SECURE=true
DB_PATH=./data/atmosiq.db
# Optional: comma-separated emails that get the admin role when they sign up
ADMIN_EMAILS=

# NASA FIRMS map key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Python FastAPI ML risk service (default: http://127.0.0.1:8000)
RISK_API_URL=http://127.0.0.1:8000
# Gemini API key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=
# New keys should use a 3.x model (2.5-* is closed to new users). 3.1-flash-lite is fast and low-cost.
GEMINI_MODEL=gemini-3.1-flash-lite
# v1 is required for newer API keys/models; v1beta returns 402 RESOURCE_EXHAUSTED on some projects
GEMINI_API_VERSION=v1
# Reserved for the live Global Forest Watch integration (not used yet)
GFW_API_KEY=
